# ==========================================
# Environment Configuration Example
# Copy file này thành .env và điền giá trị phù hợp
# ==========================================

# ─── Server ───
SERVER_PORT=8080

# ─── JWT (JSON Web Token) ───
JWT_PRIVATE_KEY_PATH=certs/private_key.pem
JWT_PUBLIC_KEY_PATH=certs/public_key.pem
JWT_EXPIRATION_MINUTE=5
JWT_REFRESH_TOKEN_EXPIRATION_DAY=7

# ─── Database (Auth Module) ───
# IDE: dùng localhost | Docker: tự override thành service name "mariadb"
AUTH_DB_URL=jdbc:mariadb://localhost:3306/auth_db?createDatabaseIfNotExist=true
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=root
AUTH_DB_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver

# ─── Docker ───
MARIADB_PORT=3306

# ─── i18n ───
# Ngôn ngữ mặc định: en (English) hoặc vi (Vietnamese)
APP_DEFAULT_LOCALE=en
