# ==============================================================================
# HỆ THỐNG BIẾN MÔI TRƯỜNG CHUẨN HOÁ (SINGLE EXACT ENVIRONMENT VARIABLES)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HẠ TẦNG DỊCH VỤ DÙNG CHUNG (GLOBAL INFRASTRUCTURE)
# ------------------------------------------------------------------------------
# Địa chỉ Eureka Server để các service tự đăng ký & định tuyến
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_HOSTNAME=localhost

# Địa chỉ Kafka Broker (messaging giữa các microservices)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Địa chỉ Redis Cache & Session
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TYPE=redis
CACHE_TTL_MINUTES=60m

# Thông tin PostgreSQL Database (Mỗi service kết nối vào database riêng qua URL này)
# Ví dụ: auth_db, user_db, post_db, media_db, chat_db, call_db, notification_db, feed_db, admin_db
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# ------------------------------------------------------------------------------
# 2. BẢO MẬT & XÁC THỰC (SECURITY & JWT)
# ------------------------------------------------------------------------------
JWT_ISSUER_URI=http://localhost:8080/auth
INTERNAL_API_KEY=kltn-internal-secret-key-prod-change-me

# Khoá công khai xác thực JWT (dùng chung cho tất cả các service)
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----  -----END PUBLIC KEY-----

# Khoá bí mật ký JWT (chỉ cần thiết cho auth-service)
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----  -----END PRIVATE KEY-----

JWT_ACCESS_TOKEN_EXPIRATION=30000
JWT_REFRESH_TOKEN_EXPIRATION=86400000

# OTP & MFA TOTP
SECURITY_OTP_LENGTH=6
SECURITY_OTP_TTL_MINUTES=5
SECURITY_OTP_RESET_TTL_MINUTES=15
MFA_TOTP_ISSUER=SocialNetworkApp
MFA_TOTP_SECRET_SIZE=20
MFA_TOTP_TIME_STEP_SECONDS=30
MFA_TOTP_CODE_DIGITS=6

# ------------------------------------------------------------------------------
# 3. ĐỊA CHỈ TRUY CẬP TRỰC TIẾP GIỮA CÁC SERVICE (INTER-SERVICE URLS)
# Dùng khi deploy phân tán ở các server/container khác nhau không qua Eureka
# ------------------------------------------------------------------------------
ADMIN_SERVICE_URL=http://localhost:8090
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8085
POST_SERVICE_URL=http://localhost:8082
MEDIA_SERVICE_URL=http://localhost:8084
CHAT_SERVICE_URL=http://localhost:8087
CALL_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8083
FEED_SERVICE_URL=http://localhost:8088
AI_SERVICE_URL=http://localhost:8091

# ------------------------------------------------------------------------------
# 4. API GATEWAY & CORS (CỔNG CHÍNH TIẾP NHẬN REQUEST)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,https://yourdomain.com

# ------------------------------------------------------------------------------
# 5. DỊCH VỤ NGOÀI: AWS S3 & MEDIA SERVICE
# ------------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_MAX_FILE_SIZE_BYTES=157286400
# Đường dẫn công khai trả về cho client xem ảnh/video (ví dụ qua API Gateway)
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/api/v1/media/files

# ------------------------------------------------------------------------------
# 6. DỊCH VỤ NGOÀI: BREVO EMAIL (NOTIFICATION SERVICE)
# ------------------------------------------------------------------------------
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@domain.com
BREVO_SENDER_NAME=System Notification

# ------------------------------------------------------------------------------
# 7. DỊCH VỤ NGOÀI: GOOGLE GEMINI AI (AI SERVICE)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
AI_SUMMARY_ENABLED=true
AI_SUMMARY_MIN_LENGTH=1000
AI_MODERATION_ENABLED=true
AI_AUTO_LEARN_ENABLED=true
AI_TOXICITY_THRESHOLD_WARN=0.40
AI_TOXICITY_THRESHOLD_HIDE=0.65
AI_TOXICITY_THRESHOLD_DELETE=0.85

# ------------------------------------------------------------------------------
# 8. FIREBASE PUSH NOTIFICATION (NOTIFICATION SERVICE)
# ------------------------------------------------------------------------------
FCM_CREDENTIALS_FILE=classpath:firebase-service-account.json
FCM_ENABLED=false
